// Sail grammar ported from `sail/src/lib/parser.mly` (Menhir) to LALRPOP.
//
// Conventions of this port:
// - Menhir tolerates shift/reduce conflicts (resolving to shift), LALRPOP
//   rejects them. The direct port failed with 4 conflicts (see GRAMMAR.md);
//   static audit in Lane 76 found a 5th (`IndexRange` parens, below). The
//   fixes are validated designs from scratch experiments with
//   LALRPOP 0.22 (see `/tmp/opencode/laltest`, exit 0):
//   - E3c (dangling `else`): open `Exp` vs closed `ClosedExp` WITHOUT an
//     `Exp ::= ClosedExp` unit production. `then`/`else` branches and every
//     tail that can end the enclosing expression are `ClosedExp`, so `else`
//     never lands in `FOLLOW(Exp)` and `if E then C` + `else` shifts
//     unambiguously (innermost binding).
//   - E4 (dangling `in`, 2x): expression-level `let`/`var` REQUIRE `in`;
//     bare `let`/`var` without `in` exist only as `BlockItem` inside strict
//     (non-empty, right-recursive) `Block`s. This also settles
//     `LoopExp ... "by" Exp "in" Typ`, since a step can no longer end in a
//     bare `let`/`var` waiting for `in`.
//   - `RDefBody` strict (Lane 87, E4 `Block` shape): non-empty,
//     right-recursive, explicit trailing-"," arm. The old nullable
//     `(<RIdDef> ",")* <RIdDef>?` list was used as `RDefBody?`, so `{}`
//     had two trees (Rig local ambiguity at 1288:5-1291:5); the use site
//     keeps `?`, so `{}` still parses, unambiguously, and the accepted
//     language is unchanged.
//   - Lane 98 (same E4 shape, Rig family): `Enum`/`ExpList`/`CaseList`/
//     `StructFields` strict with `?` use sites where the port accepted
//     empty bodies; `IndexRange`/`@` and `AtomicIndexRange`/`..` as
//     explicit arms (no `?` tail); `LoopExp` `by`/`in` as four explicit
//     arms; `TypSchm` with/without `effect` as two arms; bare
//     `let`/`var` moved from `BlockItem` into explicit `Block` arms
//     carrying their `;` terminator, so after `let p = E` the lookahead
//     decides by shift only (`in` continues, `;` continues the block)
//     and only `}` reduces — no reduce-vs-shift on `in` anymore.
//   - Lane 99 (same E4 shape, Restfamilie nach Rig 175801): `TypList`/
//     `NumList` (Rig 310/324, 324 als Headline) + `PatList`/`MPatList`/
//     `FPatList`/`FMPatList`/`FexpList`/`VecUpdList`/`MapClList`/
//     `ParamKOptList`/`EnumFns`/`TypeUnions`/`SubstList`/`ExternBindList`/
//     `AttrKVList`/`AttrDataList` strikt mit `?`-Use-Sites wo der Port
//     `{}`/`[]`/`()` akzeptierte; Tuple-Use-Sites (`Typ`/`Pat`/`MPat`/
//     `Exp`) als drei explizite Arme (`(x)`, `(x,)`, `(x, ...)`); Vektor-/
//     Listen-Inlines (`[...]`, `[|...|]`) wiederverwenden die strikten
//     Listen; `(...)+`-Makro-Reste (`MPatOps`-Kette, `ConfigKey`-`.`) als
//     explizite rechts-rekursive Arme; `?`-Schwaenze als explizite Arme
//     (`CallArgs`/`IdCallTail`/`PatIdTail`/`MPatIdTail`/`MPatSuffix`,
//     `VecUpd`-Tails, `FMPat`-`=`, `UnbracketedTyParam`-`constraint`,
//     `RegDef`-`=`).
//   - Lane 103 (Rig 183338): `AbstractInst` peels the first `config` key
//     into two explicit arms with a use-site-local `ConfigKeyTail`, so the
//     outer `.`-vs-stop decision state has a single-path context (the old
//     shared `ConfigKey` re-created it on every encoding: right-recursive
//     merged the outer/inner after-`RawId` cores, Rig 1375; left-recursive
//     Lane 102 kept the shared state, Rig 1385); `RIdDef` uses a dedicated
//     `RegAttrs`/`RegAttrsTail` copy of `Attrs`/`AttrsTail` (per-use-site
//     dedup against LALR-merge imprecision, Rig 1547). Same keys and
//     attributes in the same order; accepted language unchanged.
//   - `IndexRange` parens removed: `"(" IndexRange ")"` duplicated
//     `AtomicTyp`'s `"(" Typ ")"` for every parenthesised type (`(t)` had
//     two trees; `(a, b)` was shift-vs-reduce on `,`) while being the only
//     way to write `(a..b)` / `(a@b)`. Bare `a..b` / `a@b` still parse;
//     parenthesised ranges are rejected (see GRAMMAR.md; 0 occurrences in
//     `sail-lib`, checked by `tests/corpus.rs` on the Rig).
//   - D1/D2 (`Typ` index-range vs tuple, paren vs tuple): UNCHANGED, pending
//     corpus evaluation via `tests/corpus.rs` (see GRAMMAR.md).
// - Every Menhir `A | A B` common-prefix rule is factored to `A B?` with
//   LALRPOP `?`/`*`.
// - Semantic actions only call AST constructors. All OCaml helper logic
//   (`simp_infix`, `same_pat_ops`, deprecation warnings, name mangling,
//   `fix_extern`, …) is dropped; see GRAMMAR.md.
// - Locations are dropped (byte offsets live in the lexer only).

use crate::ast::*;
use crate::lexer::{LexError, Tok};

grammar;

extern {
    type Location = usize;
    type Error = LexError;
    enum Tok {
        "and" => Tok::And,
        "as" => Tok::As,
        "assert" => Tok::Assert,
        "bitzero" => Tok::Bitzero,
        "bitone" => Tok::Bitone,
        "by" => Tok::By,
        "match" => Tok::Match,
        "config" => Tok::Config,
        "clause" => Tok::Clause,
        "dec" => Tok::Dec,
        "default" => Tok::Default,
        "effect" => Tok::Effect,
        "end" => Tok::End,
        "operator" => Tok::OperatorKw,
        "enum" => Tok::Enum,
        "else" => Tok::Else,
        "exit" => Tok::Exit,
        "cast" => Tok::Cast,
        "false" => Tok::False,
        "forall" => Tok::Forall,
        "foreach" => Tok::Foreach,
        "function" => Tok::Function,
        "mapping" => Tok::Mapping,
        "overload" => Tok::Overload,
        "throw" => Tok::Throw,
        "try" => Tok::Try,
        "catch" => Tok::Catch,
        "if" => Tok::If,
        "in" => Tok::In,
        "inc" => Tok::Inc,
        "let" => Tok::Let,
        "var" => Tok::Var,
        "ref" => Tok::Ref,
        "Int" => Tok::Int,
        "Nat" => Tok::Nat,
        "Order" => Tok::Order,
        "Bool" => Tok::Bool,
        "pure" => Tok::Pure,
        "impure" => Tok::Impure,
        "monadic" => Tok::Monadic,
        "register" => Tok::Register,
        "return" => Tok::Return,
        "scattered" => Tok::Scattered,
        "sizeof" => Tok::Sizeof,
        "constraint" => Tok::Constraint,
        "constant" => Tok::Constant,
        "struct" => Tok::Struct,
        "then" => Tok::Then,
        "true" => Tok::True,
        "Type" => Tok::Type,
        "type" => Tok::Typedef,
        "undefined" => Tok::Undefined,
        "union" => Tok::Union,
        "newtype" => Tok::Newtype,
        "with" => Tok::With,
        "when" => Tok::When,
        "val" => Tok::Val,
        "outcome" => Tok::Outcome,
        "instantiation" => Tok::Instantiation,
        "impl" => Tok::Impl,
        "private" => Tok::Private,
        "repeat" => Tok::Repeat,
        "until" => Tok::Until,
        "while" => Tok::While,
        "do" => Tok::Do,
        "mutual" => Tok::Mutual,
        "bitfield" => Tok::Bitfield,
        "configuration" => Tok::Configuration,
        "termination_measure" => Tok::TerminationMeasure,
        "forwards" => Tok::Forwards,
        "backwards" => Tok::Backwards,
        "from" => Tok::From,
        "to" => Tok::To,
        "downto" => Tok::Downto,
        "internal_plet" => Tok::InternalPLet,
        "internal_return" => Tok::InternalReturn,
        "internal_assume" => Tok::InternalAssume,
        "|" => Tok::Bar,
        "," => Tok::Comma,
        "." => Tok::Dot,
        "-" => Tok::Minus,
        ";" => Tok::Semi,
        "_" => Tok::Under,
        ".." => Tok::DotDot,
        "@" => Tok::At,
        "::" => Tok::ColonColon,
        "^" => Tok::Caret,
        "*" => Tok::Star,
        "{" => Tok::Lcurly,
        "}" => Tok::Rcurly,
        "(" => Tok::Lparen,
        ")" => Tok::Rparen,
        "[" => Tok::Lsquare,
        "]" => Tok::Rsquare,
        "{|" => Tok::LcurlyBar,
        "|}" => Tok::RcurlyBar,
        "[|" => Tok::LsquareBar,
        "|]" => Tok::RsquareBar,
        "->" => Tok::MinusGt,
        "<->" => Tok::Bidir,
        "2^" => Tok::TwoCaret,
        "=" => Tok::Eq,
        "=>" => Tok::EqGt,
        "()" => Tok::Unit,
        ":" => Tok::Colon,
        RawId => Tok::Id(<String>),
        RawTyVar => Tok::TyVar(<String>),
        RawNum => Tok::Num(<String>),
        RawBin => Tok::Bin(<String>),
        RawHex => Tok::Hex(<String>),
        RawReal => Tok::Real(<String>),
        RawStr => Tok::Str(<String>),
        RawOpId => Tok::OpId(<String>),
        RawDocBlock => Tok::DocBlock(<String>),
        RawDocLine => Tok::DocLine(<String>),
        RawPragma => Tok::Pragma(<String>, <String>),
        RawStructPragma => Tok::StructPragma(<String>),
        RawAttr => Tok::Attr(<String>),
        RawFixity => Tok::Fixity(<FixAssoc>, <u8>, <String>),
    }
}

// ---------------------------------------------------------------------------
// identifiers & operators
// ---------------------------------------------------------------------------

// `id` in parser.mly.
Ident: String = {
    <s:RawId> => s,
    "operator" <o:RawOpId> => o,
    "operator" "-" => "-".to_string(),
    "operator" "|" => "|".to_string(),
    "operator" "^" => "^".to_string(),
    "operator" "*" => "*".to_string(),
}

// `op_no_caret` (type operators without `^`).
OpNoCaret: String = {
    <o:RawOpId> => o,
    "-" => "-".to_string(),
    "|" => "|".to_string(),
    "*" => "*".to_string(),
    "in" => "in".to_string(),
}

// `op` (all type operators).
Op: String = {
    <o:OpNoCaret> => o,
    "^" => "^".to_string(),
}

// `exp_op` (expression operators).
ExpOp: String = {
    <o:RawOpId> => o,
    "-" => "-".to_string(),
    "|" => "|".to_string(),
    "@" => "@".to_string(),
    "::" => "::".to_string(),
    "^" => "^".to_string(),
    "*" => "*".to_string(),
}

// `pat_op` (pattern operators).
PatOp: PatOp = {
    "@" => PatOp::VectorConcat,
    "::" => PatOp::Cons,
    "^" => PatOp::StringAppend,
}

// `kid` (type variable).
Kid: String = {
    <s:RawTyVar> => s,
}

// ---------------------------------------------------------------------------
// types
// ---------------------------------------------------------------------------

pub Typ: Typ = {
    "if" <c:InfixTyp> "then" <t:InfixTyp> "else" <e:Typ>
        => Typ::If(Box::new(c), Box::new(t), Box::new(e)),
    <t:InfixTyp> => t,
}

// `infix_typ`: prefix operators, head, `(operator, prefixes, item)` tail.
InfixTyp: Typ = {
    <p:PrefixTypOp*> <x:PostfixTyp> <xs:(<Op> <PrefixTypOp*> <PostfixTyp>)*> => {
        if p.is_empty() && xs.is_empty() {
            x
        } else {
            Typ::Infix(Box::new(InfixChain { prefixes: p, head: x, tail: xs }))
        }
    },
}

// `typ_no_caret`: same shape without `^` (used after `:` in patterns).
TypNoCaret: Typ = {
    <p:PrefixTypOp*> <x:PostfixTyp> <xs:(<OpNoCaret> <PrefixTypOp*> <PostfixTyp>)*> => {
        if p.is_empty() && xs.is_empty() {
            x
        } else {
            Typ::Infix(Box::new(InfixChain { prefixes: p, head: x, tail: xs }))
        }
    },
}

// `prefix_typ_op` (operator names only; positions dropped).
PrefixTypOp: String = {
    "2^" => "pow2".to_string(),
    "-" => "negate".to_string(),
    "*" => "__deref".to_string(),
}

PostfixTyp: Typ = {
    <t:AtomicTyp> => t,
}

// `atomic_typ`.
AtomicTyp: Typ = {
    <i:Ident> <args:TyArgs?> => match args {
        Some(a) => Typ::App(i, a),
        None => Typ::Id(i),
    },
    "_" => Typ::Wild,
    <k:Kid> => Typ::Var(k),
    <l:Lit> => Typ::Lit(l),
    "dec" => Typ::Dec,
    "inc" => Typ::Inc,
    "register" "(" <t:Typ> ")" => Typ::App("register".to_string(), vec![t]),
    "(" <t:Typ> ")" => t,
    "(" <t:Typ> "," <ts:TypList> ")" => {
        let mut v = vec![t];
        v.extend(ts);
        Typ::Tuple(v)
    },
    "(" <t:Typ> "," ")" => Typ::Tuple(vec![t]),
    "{" <ns:NumList?> "}" => Typ::NSet(ns.unwrap_or_default()),
    "{|" <ns:NumList?> "|}" => Typ::NSet(ns.unwrap_or_default()),
    "{" <ks:KOptList> "." <t:Typ> "}" =>
        Typ::Exist(ks, Box::new(Typ::Lit(Lit::True)), Box::new(t)),
    "{" <ks:KOptList> "," <c:Typ> "." <t:Typ> "}" =>
        Typ::Exist(ks, Box::new(c), Box::new(t)),
}

// `tyarg`.
TyArgs: Vec<Typ> = {
    "()" => vec![],
    "(" <ts:TypList?> ")" => ts.unwrap_or_default(),
}

// `typ_list` (trailing comma allowed).
// `typ_list`: E4-strict (Lane 99) — non-empty, right-recursive, explicit
// trailing-"," arm (Lane-87 `RDefBody` shape). The old nullable
// `(<Typ> ",")* <Typ>?` list expanded to `(...)+`/`(...)*` intermediates
// whose shifts/reduces competed on every `Typ`-leading token
// (Rig 310:5-313:5). The tuple use site above keeps three explicit arms
// so `(t)`, `(t,)` and `(t, ...)` all parse as before; `TyArgs` keeps
// `?`, so `()` still parses (via `None`); accepted language unchanged.
TypList: Vec<Typ> = {
    <t:Typ> => vec![t],
    <t:Typ> "," <ts:TypList> => {
        let mut v = vec![t];
        v.extend(ts);
        v
    },
    <t:Typ> "," => vec![t],
}

// `negative_num`.
NegNum: String = {
    <n:RawNum> => n,
    "-" <n:RawNum> => format!("-{n}"),
}

// `num_list` (trailing comma allowed).
// `num_list`: E4-strict (Lane 99) — non-empty, right-recursive, explicit
// trailing-"," arm (Lane-87 `RDefBody` shape). The old nullable
// `(<NegNum> ",")* <NegNum>?` list expanded to `(...)+`/`(...)*`
// intermediates whose empty-reduce competed with every `KOptList`-leading
// token after `{` (Rig 324:5-327:5, headline conflict). Use sites keep
// `?`, so `{}` / `{||}` still parse (via `None`); accepted language
// unchanged.
NumList: Vec<String> = {
    <n:NegNum> => vec![n],
    <n:NegNum> "," <ns:NumList> => {
        let mut v = vec![n];
        v.extend(ns);
        v
    },
    <n:NegNum> "," => vec![n],
}

// `kind`.
Kind: Kind = {
    "Int" => Kind::Int,
    "Nat" => Kind::Nat,
    "Type" => Kind::Type,
    "Order" => Kind::Order,
    "Bool" => Kind::Bool,
}

// `kid_list`.
KidList: Vec<String> = {
    <ks:Kid+> => ks,
}

// `kopt`.
KOpt: KOpt = {
    "(" <c:"constant"?> <ks:KidList> ":" <k:Kind> ")" => KOpt {
        constant: c.is_some(),
        kids: ks,
        kind: Some(k),
    },
    <k:Kid> => KOpt { constant: false, kids: vec![k], kind: None },
}

// `kopt_list`.
KOptList: Vec<KOpt> = {
    <ks:KOpt+> => ks,
}

// `typquant`.
TypQuant: TypQuant = {
    <ks:KOptList> <c:("," <Typ>)?> => TypQuant {
        kopts: ks,
        constraint: c.map(Box::new),
    },
}

ForallPart: TypQuant = {
    "forall" <q:TypQuant> "." => q,
}

// `typschm`.
// `typschm`: the optional `effect` tail is two explicit arms (Lane 98) —
// the old `("effect" <EffectSet>)?` tail left an empty production whose
// reduce competed with the `effect` shift (Rig 358:5-364:5). Accepted
// language unchanged.
pub TypSchm: TypSchm = {
    <q:ForallPart?> <l:Typ> <a:Arrow> <r:Typ> => TypSchm {
        quant: q,
        lhs: l,
        arrow: a,
        rhs: r,
        effect: None,
    },
    <q:ForallPart?> <l:Typ> <a:Arrow> <r:Typ> "effect" <e:EffectSet> => TypSchm {
        quant: q,
        lhs: l,
        arrow: a,
        rhs: r,
        effect: Some(e),
    },
}

Arrow: Arrow = {
    "->" => Arrow::Fn,
    "<->" => Arrow::Bidir,
}

EffectSet: Vec<String> = {
    "{" <es:EffectList> "}" => es,
    "pure" => vec![],
}

EffectList: Vec<String> = {
    <e:EffectAnnot> <mut es:("," <EffectAnnot>)*> => {
        let mut v = vec![e];
        v.append(&mut es);
        v
    },
}

EffectAnnot: String = {
    <i:Ident> => i,
    "configuration" => "configuration".to_string(),
}

// ---------------------------------------------------------------------------
// literals & patterns
// ---------------------------------------------------------------------------

// `lit`.
Lit: Lit = {
    "true" => Lit::True,
    "false" => Lit::False,
    "()" => Lit::Unit,
    <n:RawNum> => Lit::Num(n),
    "bitzero" => Lit::Zero,
    "bitone" => Lit::One,
    <b:RawBin> => Lit::Bin(b),
    <h:RawHex> => Lit::Hex(h),
    <s:RawStr> => Lit::Str(s),
    <r:RawReal> => Lit::Real(r),
}

// `negative_lit`.
NegLit: Lit = {
    "-" <n:RawNum> => Lit::Num(format!("-{n}")),
    <l:Lit> => l,
}

// `pat`.
pub Pat: Pat = {
    <a:Attrs> <p:Pat> => Pat::Attr(a, Box::new(p)),
    <p:Pat1> <t:(AsKw <Typ>)?> => match t {
        Some(ty) => Pat::As(Box::new(p), ty),
        None => p,
    },
}

// `as` / `match` type-annotation keywords (identical meaning).
AsKw: () = {
    "as" => (),
    "match" => (),
}

// `pat1`: head with `(operator, item)` tail (no same-operator check).
Pat1: Pat = {
    <p:AtomicPat> <ops:(<PatOp> <AtomicPat>)*> => {
        if ops.is_empty() { p } else { Pat::Infix(Box::new(p), ops) }
    },
}

// `pat_list` (trailing comma allowed).
// `pat_list`: E4-strict (Lane 99, same shape as `TypList` above).
// Use sites: the tuple site keeps three explicit arms so `(p)`, `(p,)`
// and `(p, ...)` all parse as before; `PatIdTail` keeps its separate
// `"()"` arm, so strictness additionally removes the old `()` double
// tree. Accepted language unchanged.
PatList: Vec<Pat> = {
    <p:Pat> => vec![p],
    <p:Pat> "," <ps:PatList> => {
        let mut v = vec![p];
        v.extend(ps);
        v
    },
    <p:Pat> "," => vec![p],
}

// `atomic_pat`: base with chained `: type` annotations.
AtomicPat: Pat = {
    <b:AtomicPatBase> <ts:(":" <TypNoCaret>)*> => {
        let mut p = b;
        for t in ts {
            p = Pat::Typ(Box::new(p), t);
        }
        p
    },
}

// Tail after a pattern head identifier.
// `PatIdTail?` use site is two explicit arms (Lane 99): the bare-`Ident`
// arm and the tailed arm, so no `?`-intermediate reduce competes with the
// `(`/`[` shifts. Accepted language unchanged.
AtomicPatBase: Pat = {
    "_" => Pat::Wild,
    <l:NegLit> => Pat::Lit(l),
    <i:Ident> => Pat::Id(i),
    <i:Ident> <t:PatIdTail> => match t {
        PatIdTail::Call(args) => Pat::App(i, args),
        PatIdTail::Subrange(lo, hi) => Pat::VectorSubrange(i, lo, hi),
    },
    <k:Kid> => Pat::KidVar(k),
    "(" <p:Pat> ")" => p,
    "(" <p:Pat> "," <ps:PatList> ")" => {
        let mut v = vec![p];
        v.extend(ps);
        Pat::Tuple(v)
    },
    "(" <p:Pat> "," ")" => Pat::Tuple(vec![p]),
    "[" <ps:PatList?> "]" => Pat::Vector(ps.unwrap_or_default()),
    "[|" <ps:PatList?> "|]" => Pat::List(ps.unwrap_or_default()),
    "struct" <i:Ident?> "{" <fs:FPatList?> "}" => Pat::Struct(i, fs.unwrap_or_default()),
}

// Tail after a pattern head identifier.
PatIdTail: PatIdTail = {
    "()" => PatIdTail::Call(vec![Pat::Lit(Lit::Unit)]),
    "(" <ps:PatList> ")" => PatIdTail::Call(ps),
    "[" <lo:RawNum> <hi:(".." <RawNum>)?> "]" => {
        let hi = hi.unwrap_or_else(|| lo.clone());
        PatIdTail::Subrange(lo, hi)
    },
}

FPatList: Vec<FieldPat> = {
    <f:FPat> => vec![f],
    <f:FPat> "," <fs:FPatList> => {
        let mut v = vec![f];
        v.extend(fs);
        v
    },
    <f:FPat> "," => vec![f],
}

// `fpat`.
FPat: FieldPat = {
    <i:Ident> <p:("=" <Pat>)?> => match p {
        Some(pat) => FieldPat::Field(i.clone(), pat),
        None => FieldPat::Field(i.clone(), Pat::Id(i)),
    },
    "_" => FieldPat::Wild,
}

// ---------------------------------------------------------------------------
// expressions
// ---------------------------------------------------------------------------

// `exp`: open expressions (E3c-`E`). A bare `if..then` without `else`
// defaults to `()` as in the Menhir port; it may appear anywhere an `Exp`
// is expected except in `then`/`else` branches and the tail positions of
// `PlainExp` (those are `ClosedExp`, E3c-`R`).
pub Exp: Exp = {
    "if" <c:Exp> "then" <t:ClosedExp> => Exp::If(
        Box::new(c),
        Box::new(t),
        Box::new(Exp::Lit(Lit::Unit)),
    ),
    "if" <c:Exp> "then" <t:ClosedExp> "else" <e:ClosedExp> => Exp::If(
        Box::new(c),
        Box::new(t),
        Box::new(e),
    ),
    <e:PlainExp> => e,
}

// E3c closed expressions: every `if` carries `else`. There is deliberately
// no `Exp ::= ClosedExp` unit production (that was the ambiguous E3b shape):
// both rules share `PlainExp` instead, so `else` stays out of `FOLLOW(Exp)`
// and `if E then C` followed by `else` shifts unambiguously.
ClosedExp: Exp = {
    "if" <c:Exp> "then" <t:ClosedExp> "else" <e:ClosedExp> => Exp::If(
        Box::new(c),
        Box::new(t),
        Box::new(e),
    ),
    <e:PlainExp> => e,
}

// All `exp` forms except `if` (shared by `Exp` and `ClosedExp`).
//
// E4 (`in`-Pflicht): expression-level `let`/`var` REQUIRE `in`; bare forms
// without `in` live only in `BlockItem`. Tail positions whose value can end
// the enclosing expression (assignment RHS, `let`/`var` bodies,
// `return`/`throw`, attribute bodies, `do` bodies, `repeat..until` RHS,
// `internal_*` bodies) are `ClosedExp`, since any of them can sit under a
// `then` branch. All other positions (conditions, scrutinees, arguments,
// elements, bodies inside braces, top-level tails) stay `Exp`.
PlainExp: Exp = {
    <l:Exp0> <r:("=" <ClosedExp>)?> => match r {
        Some(e) => Exp::Assign(Box::new(l), Box::new(e)),
        None => l,
    },
    <a:Attrs> <e:ClosedExp> => Exp::Attr(a, Box::new(e)),
    "let" <p:Pat> "=" <e:Exp> "in" <b:ClosedExp> => Exp::Let(
        p,
        Box::new(e),
        Box::new(b),
    ),
    "var" <a:AtomicExp> "=" <e:Exp> "in" <b:ClosedExp> => Exp::Var(
        Box::new(a),
        Box::new(e),
        Box::new(b),
    ),
    "return" <e:ClosedExp> => Exp::Return(Box::new(e)),
    "throw" <e:ClosedExp> => Exp::Throw(Box::new(e)),
    "match" <e:Exp> "{" <cs:CaseList?> "}" => Exp::Match(Box::new(e), cs.unwrap_or_default()),
    "try" <e:Exp> "catch" "{" <cs:CaseList?> "}" => Exp::Try(Box::new(e), cs.unwrap_or_default()),
    "foreach" "(" <l:LoopExp> ")" "do"? <e:ClosedExp> => Exp::For(Box::new(l), Box::new(e)),
    "foreach" <l:LoopExp> "{" <b:Block> "}" => Exp::For(
        Box::new(l),
        Box::new(Exp::Block(b)),
    ),
    "foreach" <l:LoopExp> "do" <e:ClosedExp> => Exp::For(Box::new(l), Box::new(e)),
    "repeat" <m:RepeatMeas?> <e1:Exp> "until" <e2:ClosedExp> => Exp::Loop(
        LoopKind::Until,
        m.unwrap_or(Measure::None),
        Box::new(e2),
        Box::new(e1),
    ),
    "while" <e1:Exp> <m:RepeatMeas?> "do" <e2:ClosedExp> => Exp::Loop(
        LoopKind::While,
        m.unwrap_or(Measure::None),
        Box::new(e1),
        Box::new(e2),
    ),
    "while" <e1:Exp> <m:RepeatMeas?> "{" <b:Block> "}" => Exp::Loop(
        LoopKind::While,
        m.unwrap_or(Measure::None),
        Box::new(e1),
        Box::new(Exp::Block(b)),
    ),
    "internal_plet" <p:Pat> "=" <e1:Exp> "in" <e2:ClosedExp>
        => Exp::InternalPlet(p, Box::new(e1), Box::new(e2)),
    "internal_return" <e:ClosedExp> => Exp::InternalReturn(Box::new(e)),
    "internal_assume" <t:AtomicTyp> "in" <e:ClosedExp>
        => Exp::InternalAssume(t, Box::new(e)),
}

RepeatMeas: Measure = {
    "termination_measure" "(" <e:Exp> ")" => Measure::Some(Box::new(e)),
}

// `loop_exp`.
// `loop_exp`: the `by`/`in` tails are four explicit arms (Lane 98) — the
// old nested `("by" <Exp>)? ("in" <Typ>)?` tails left empty productions
// whose reduces competed with the `by`/`in` shifts (Rig 610:5-617:5).
// Same four combinations as before; accepted language unchanged.
LoopExp: LoopHead = {
    <v:Ident> "from" <f:Exp> <o:ToOrd> <t:Exp> => LoopHead {
        var: v,
        from: Box::new(f),
        ord: o,
        to: Box::new(t),
        step: None,
        order: None,
    },
    <v:Ident> "from" <f:Exp> <o:ToOrd> <t:Exp> "by" <s:Exp> => LoopHead {
        var: v,
        from: Box::new(f),
        ord: o,
        to: Box::new(t),
        step: Some(Box::new(s)),
        order: None,
    },
    <v:Ident> "from" <f:Exp> <o:ToOrd> <t:Exp> "in" <ord:Typ> => LoopHead {
        var: v,
        from: Box::new(f),
        ord: o,
        to: Box::new(t),
        step: None,
        order: Some(ord),
    },
    <v:Ident> "from" <f:Exp> <o:ToOrd> <t:Exp> "by" <s:Exp> "in" <ord:Typ> => LoopHead {
        var: v,
        from: Box::new(f),
        ord: o,
        to: Box::new(t),
        step: Some(Box::new(s)),
        order: Some(ord),
    },
}

ToOrd: LoopOrd = {
    "to" => LoopOrd::To,
    "downto" => LoopOrd::Downto,
}

// `exp0`: prefix operators, head, `(operator, prefixes, item)` tail.
Exp0: Exp = {
    <p:PrefixOp*> <x:AtomicExp> <xs:(<ExpOp> <PrefixOp*> <AtomicExp>)*> => {
        if p.is_empty() && xs.is_empty() {
            x
        } else {
            Exp::Infix(Box::new(InfixChain { prefixes: p, head: x, tail: xs }))
        }
    },
}

// `prefix_op` (operator names only).
PrefixOp: String = {
    "2^" => "pow2".to_string(),
    "-" => "negate".to_string(),
    "*" => "__deref".to_string(),
}

// `case`.
Case: PatExp = {
    <a:Attrs> <c:AttrCase> => PatExp::Attr(a, Box::new(c)),
    <p:Pat> <g:("if" <Exp>)?> "=>" <b:Exp> => match g {
        Some(guard) => PatExp::When(p, Box::new(guard), Box::new(b)),
        None => PatExp::Exp(p, Box::new(b)),
    },
}

AttrCase: PatExp = {
    "(" <c:Case> ")" => c,
    <a:Attrs> <c:AttrCase> => PatExp::Attr(a, Box::new(c)),
}

// `case_list` (trailing comma allowed).
// `case_list`: E4-strict (Lane 98) — non-empty, right-recursive, explicit
// trailing-"," arm (Lane-87 `RDefBody` shape). The old nullable
// `(<Case> ",")* <Case>?` list expanded to `(...)+`/`(...)*` intermediates
// whose shifts/reduces competed on every `Case`-leading token
// (Rig 659:5-662:5). Use sites keep `?`, so `{}` still parses (via
// `None`); accepted language unchanged.
CaseList: Vec<PatExp> = {
    <c:Case> => vec![c],
    <c:Case> "," <cs:CaseList> => {
        let mut v = vec![c];
        v.extend(cs);
        v
    },
    <c:Case> "," => vec![c],
}

// `block`: E4 strict — non-empty and right-recursive (as in the validated
// toy), so a trailing `;` parses but `{}` does not. Bare `let`/`var`
// without `in` live here as explicit `Block` arms carrying their `;`
// terminator (Lane 98): after `let p = E` the lookahead decides by shift
// only (`in` continues the `PlainExp` form, `;` continues the block) and
// only `}` reduces — the old `BlockItem` bare arms reduced against the
// `PlainExp` `in` shift (Rig 682:5-691:5). The missing body defaults to
// `()` as in the Menhir port; accepted language unchanged (in particular
// `{ let p = E }`, `{ let p = E; }` and `{ let p = E; ... }` all parse).
Block: Vec<Exp> = {
    <i:BlockItem> => vec![i],
    <i:BlockItem> ";" <b:Block> => {
        let mut v = vec![i];
        v.extend(b);
        v
    },
    <i:BlockItem> ";" => vec![i],
    "let" <p:Pat> "=" <e:Exp> => vec![Exp::Let(
        p,
        Box::new(e),
        Box::new(Exp::Lit(Lit::Unit)),
    )],
    "let" <p:Pat> "=" <e:Exp> ";" => vec![Exp::Let(
        p,
        Box::new(e),
        Box::new(Exp::Lit(Lit::Unit)),
    )],
    "let" <p:Pat> "=" <e:Exp> ";" <b:Block> => {
        let mut v = vec![Exp::Let(
            p,
            Box::new(e),
            Box::new(Exp::Lit(Lit::Unit)),
        )];
        v.extend(b);
        v
    },
    "var" <a:AtomicExp> "=" <e:Exp> => vec![Exp::Var(
        Box::new(a),
        Box::new(e),
        Box::new(Exp::Lit(Lit::Unit)),
    )],
    "var" <a:AtomicExp> "=" <e:Exp> ";" => vec![Exp::Var(
        Box::new(a),
        Box::new(e),
        Box::new(Exp::Lit(Lit::Unit)),
    )],
    "var" <a:AtomicExp> "=" <e:Exp> ";" <b:Block> => {
        let mut v = vec![Exp::Var(
            Box::new(a),
            Box::new(e),
            Box::new(Exp::Lit(Lit::Unit)),
        )];
        v.extend(b);
        v
    },
}

// Block item: any expression (expression-level `let`/`var` require `in`
// via `PlainExp`; bare forms are `Block` arms above, so no rule here ever
// reduces against an `in` shift).
BlockItem: Exp = {
    <e:Exp> => e,
}

// `atomic_exp`: head with applied suffixes, folded left to right.
AtomicExp: Exp = {
    <b:AtomBase> <ss:AtomSuffix*> => {
        if ss.is_empty() {
            b
        } else {
            Exp::Suffix(Box::new(b), ss)
        }
    },
}

AtomSuffix: ExpSuffix = {
    "." <i:Ident> => ExpSuffix::Field(i),
    "." <i:Ident> <a:CallArgs> => ExpSuffix::Call(i, a),
    ":" <t:AtomicTyp> => ExpSuffix::TypAnnot(t),
    "[" <e:Exp> "]" => ExpSuffix::Index(Box::new(e)),
    "[" <hi:Exp> ".." <lo:Exp> "]" => ExpSuffix::Subrange(Box::new(hi), Box::new(lo)),
    "[" <a:Exp> "," <b:Exp> "]" => ExpSuffix::Slice(Box::new(a), Box::new(b)),
}

AtomBase: Exp = {
    "config" <i:RawId> => Exp::Config(i),
    "undefined" => Exp::Undef,
    <l:Lit> => Exp::Lit(l),
    <i:Ident> => Exp::Id(i),
    <i:Ident> <t:IdCallTail> => Exp::App(i, t),
    <i:Ident> "->" <g:Ident> <a:IdCallTail> =>
        Exp::Suffix(Box::new(Exp::Id(i)), vec![ExpSuffix::Call(g, a)]),
    <k:Kid> => Exp::Sizeof(Typ::Var(k)),
    "ref" <i:Ident> => Exp::Ref(i),
    "exit" <a:ExitArgs> => Exp::Exit(Box::new(a)),
    "sizeof" "(" <t:Typ> ")" => Exp::Sizeof(t),
    "constraint" "(" <t:Typ> ")" => Exp::Constraint(t),
    "assert" "(" <e:Exp> <m:("," <Exp>)?> ")" => Exp::Assert(
        Box::new(e),
        Box::new(m.unwrap_or(Exp::Lit(Lit::Str(String::new())))),
    ),
    "struct" <i:Ident?> "{" <fs:FexpList?> "}" => Exp::Struct(i, fs.unwrap_or_default()),
    "(" <e:Exp> ")" => e,
    "(" <e:Exp> "," <es:ExpList> ")" => {
        let mut v = vec![e];
        v.extend(es);
        Exp::Tuple(v)
    },
    "(" <e:Exp> "," ")" => Exp::Tuple(vec![e]),
    "[" "]" => Exp::Vector(vec![]),
    "[" <e:Exp> "with" <us:VecUpdList?> "]" => Exp::VectorUpdate(
        Box::new(e),
        us.unwrap_or_default(),
    ),
    "[" <e:Exp> "]" => Exp::Vector(vec![e]),
    "[" <e:Exp> "," <es:ExpList?> "]" => {
        let mut v = vec![e];
        v.extend(es.unwrap_or_default());
        Exp::Vector(v)
    },
    "[|" <es:ExpList?> "|]" => Exp::List(es.unwrap_or_default()),
    "{" <b:BlockOrUpd> "}" => b,
}

// Call arguments after an identifier or `.field`.
IdCallTail: Vec<Exp> = {
    "()" => vec![Exp::Lit(Lit::Unit)],
    "(" <es:ExpList> ")" => es,
}

CallArgs: Vec<Exp> = {
    "()" => vec![Exp::Lit(Lit::Unit)],
    "(" <es:ExpList> ")" => es,
}

ExitArgs: Exp = {
    "()" => Exp::Lit(Lit::Unit),
    "(" <e:Exp> ")" => e,
}

// `exp_list` (trailing comma allowed).
// `exp_list`: E4-strict (Lane 98) — non-empty, right-recursive, explicit
// trailing-"," arm (Lane-87 `RDefBody` shape). The old nullable
// `(<Exp> ",")* <Exp>?` list expanded to `(...)+`/`(...)*` intermediates
// whose shifts/reduces competed on every `Exp`-leading token
// (Rig 779:5-782:5). Every use site already guards the list with a
// leading element plus `,` (tuples) or a separate `"()"` arm (calls), so
// no use-site change is needed; accepted language unchanged.
ExpList: Vec<Exp> = {
    <e:Exp> => vec![e],
    <e:Exp> "," <es:ExpList> => {
        let mut v = vec![e];
        v.extend(es);
        v
    },
    <e:Exp> "," => vec![e],
}

// `{ block | exp with updates }`.
BlockOrUpd: Exp = {
    <b:Block> => Exp::Block(b),
    <e:Exp> "with" <fs:FexpList?> => Exp::StructUpdate(
        Box::new(e),
        fs.unwrap_or_default(),
    ),
}

// `fexp_exp`.
Fexp: FieldExp = {
    <a:AtomicExp> <e:("=" <Exp>)?> => match e {
        Some(rhs) => FieldExp::Field(Box::new(a.clone()), Box::new(rhs)),
        None => match a {
            Exp::Id(i) => FieldExp::Punning(i),
            other => FieldExp::Field(Box::new(other.clone()), Box::new(other)),
        },
    },
}

// `fexp_list` (trailing comma allowed).
// E4-strict (Lane 99): the old nullable list expanded to `(...)+`
// intermediates (Rig 910:5-913:5). Use sites keep `?`, so `struct {}`
// still parses (via `None`); accepted language unchanged.
FexpList: Vec<FieldExp> = {
    <f:Fexp> => vec![f],
    <f:Fexp> "," <fs:FexpList> => {
        let mut v = vec![f];
        v.extend(fs);
        v
    },
    <f:Fexp> "," => vec![f],
}

// `vector_update`: the `VecUpdTail?` tail is three explicit arms
// (Lane 99, Fix-8 shape) — the old tail left an empty production whose
// reduce competed with the `=`/`..` shifts (Rig 918:5-926:5). Same three
// combinations as before; accepted language unchanged.
VecUpd: VectorUpdate = {
    <a:AtomicExp> => VectorUpdate::Single(
        Box::new(a.clone()),
        Box::new(a),
    ),
    <a:AtomicExp> "=" <e:Exp> => VectorUpdate::Single(Box::new(a), Box::new(e)),
    <a:AtomicExp> ".." <hi:AtomicExp> "=" <e:Exp> =>
        VectorUpdate::Range(Box::new(a), Box::new(hi), Box::new(e)),
}

// `vector_update_list` (trailing comma allowed).
// E4-strict (Lane 99): the old nullable list expanded to `(...)+`
// intermediates (Rig 935:5-938:5). The `with` use site keeps `?`, so
// `[e with ]` still parses (via `None`); accepted language unchanged.
VecUpdList: Vec<VectorUpdate> = {
    <u:VecUpd> => vec![u],
    <u:VecUpd> "," <us:VecUpdList> => {
        let mut v = vec![u];
        v.extend(us);
        v
    },
    <u:VecUpd> "," => vec![u],
}

// ---------------------------------------------------------------------------
// attributes & documentation
// ---------------------------------------------------------------------------

// `attributes`: E4-explicit (Lane 102) — the old `<d:AttrData?>` tail
// expanded to `RawAttr AttrData AttrsTail` / `RawAttr AttrsTail`
// intermediates whose empty-reduce competed with the `RawAttr` shift
// (Rig 1529:5-1529:29, reduce-`RDefBody` vs shift on every `RIdDef`
// starter). Same combinations as before; accepted language unchanged.
Attrs: Vec<Attr> = {
    <a:RawAttr> <d:AttrData> <t:AttrsTail> => {
        let mut v = vec![Attr { name: a, data: Some(d) }];
        v.extend(t);
        v
    },
    <a:RawAttr> <t:AttrsTail> => {
        let mut v = vec![Attr { name: a, data: None }];
        v.extend(t);
        v
    },
}

AttrsTail: Vec<Attr> = {
    "," <i:RawId> <d:AttrData> <t:AttrsTail> => {
        let mut v = vec![Attr { name: i, data: Some(d) }];
        v.extend(t);
        v
    },
    "," <i:RawId> <t:AttrsTail> => {
        let mut v = vec![Attr { name: i, data: None }];
        v.extend(t);
        v
    },
    "]" => vec![],
}

// `attribute_data`.
AttrData: AttrData = {
    "{" <kvs:AttrKVList?> "}" => AttrData::Object(kvs.unwrap_or_default()),
    <n:RawNum> => AttrData::Num(n),
    <s:RawStr> => AttrData::Str(s),
    <i:RawId> => AttrData::Str(i),
    "true" => AttrData::Bool(true),
    "false" => AttrData::Bool(false),
    "[" <ds:AttrDataList?> "]" => AttrData::List(ds.unwrap_or_default()),
}

// `attribute_data` list: E4-strict (Lane 99); the use site keeps `?`, so
// `[]` still parses (via `None`); accepted language unchanged.
AttrDataList: Vec<AttrData> = {
    <d:AttrData> => vec![d],
    <d:AttrData> "," <ds:AttrDataList> => {
        let mut v = vec![d];
        v.extend(ds);
        v
    },
    <d:AttrData> "," => vec![d],
}

AttrKVList: Vec<(String, AttrData)> = {
    <kv:AttrKV> => vec![kv],
    <kv:AttrKV> "," <kvs:AttrKVList> => {
        let mut v = vec![kv];
        v.extend(kvs);
        v
    },
    <kv:AttrKV> "," => vec![kv],
}

// `attribute_data_key_value`.
AttrKV: (String, AttrData) = {
    <k:RawId> "=" <v:AttrData> => (k, v),
    <k:RawStr> "=" <v:AttrData> => (k, v),
}

// `doc_comment`.
DocComment: DocComment = {
    <s:RawDocBlock> => DocComment::Block(s),
    <s:RawDocLine> => DocComment::Line(s),
}

// ---------------------------------------------------------------------------
// functions
// ---------------------------------------------------------------------------

FunclAnnot: Annot = {
    "private" => Annot::Private,
    <a:Attrs> => Annot::Attr(a),
    <d:DocComment> => Annot::Doc(d),
}

// `(pat | (pat if guard))`.
GuardedPat: GuardedPat = {
    "(" <p:Pat> "if" <g:Exp> ")" => GuardedPat::Guarded(p, g),
    <p:Pat> => GuardedPat::Plain(p),
}

// `funcl_patexp` (untyped clause).
Patexp: (GuardedPat, Exp) = {
    <p:GuardedPat> "=" <e:Exp> => (p, e),
}

// `funcl` (clause after `and`, or standalone without `function`).
Funcl: Funcl = {
    <a:FunclAnnot*> <f:Ident> <p:Patexp> => Funcl {
        annots: a,
        name: f,
        pat: p.0,
        typ: None,
        body: PatExpBody::Exp(Box::new(p.1)),
    },
}

// `funcl_patexp_typ`: (pattern, optional annotation, body).
PatexpTyp: (GuardedPat, Option<(Option<TypQuant>, Typ)>, PatExpBody) = {
    <q:ForallPart> <p:GuardedPat> "->" <t:Typ> "=" <e:Exp> => (
        p,
        Some((Some(q), t)),
        PatExpBody::Exp(Box::new(e)),
    ),
    <p:GuardedPat> <t:("->" <Typ>)?> "=" <e:Exp> => (
        p,
        t.map(|ty| (None, ty)),
        PatExpBody::Exp(Box::new(e)),
    ),
}

// `fun_def`.
FunDef: FunDef = {
    "function" <m:RecMeasure?> <a:FunclAnnot*> <f:Ident> <pt:PatexpTyp> <t:("and" <Funcl>)*> => {
        let (pat, typ, body) = pt;
        FunDef {
            rec_measure: m,
            head: Funcl { annots: a, name: f, pat, typ, body },
            tail: t,
        }
    },
}

// `rec_measure`.
RecMeasure: (Pat, Exp) = {
    "{" <p:Pat> "=>" <e:Exp> "}" => (p, e),
}

// `fun_def_list` (for `mutual`).
FunDefList: Vec<FunDef> = {
    <fs:FunDef+> => fs,
}

// ---------------------------------------------------------------------------
// mappings
// ---------------------------------------------------------------------------

MPat: MPat = {
    <a:AtomicMPat> => a,
    <a:AtomicMPat> <s:MPatSuffix> => match s {
        MPatSuffix::Chain(ops) => MPat::Infix(Box::new(a), ops),
        MPatSuffix::As(i) => MPat::As(Box::new(a), i),
    },
}

MPatSuffix: MPatSuffix = {
    <ops:MPatOps> => MPatSuffix::Chain(ops),
    "as" <i:Ident> => MPatSuffix::As(i),
}

// Operator chain after a mapping-pattern head: E4-strict right-recursive
// (Lane 99) instead of the `(<PatOp> <AtomicMPat>)+` macro chunk, whose
// intermediates compete the same way as the reported `(...)+` list states.
MPatOps: Vec<(PatOp, MPat)> = {
    <o:PatOp> <m:AtomicMPat> => vec![(o, m)],
    <o:PatOp> <m:AtomicMPat> <t:MPatOps> => {
        let mut v = vec![(o, m)];
        v.extend(t);
        v
    },
}

// `mpat_list` (trailing comma allowed).
// E4-strict (Lane 99): the old nullable list expanded to `(...)+`
// intermediates (Rig 1083:5-1086:5). The tuple use site below keeps
// three explicit arms; `MPatIdTail` keeps its separate `"()"` arm, so
// strictness additionally removes the old `()` double tree. Accepted
// language unchanged.
MPatList: Vec<MPat> = {
    <m:MPat> => vec![m],
    <m:MPat> "," <ms:MPatList> => {
        let mut v = vec![m];
        v.extend(ms);
        v
    },
    <m:MPat> "," => vec![m],
}

AtomicMPat: MPat = {
    <b:AtomicMPatBase> <ts:(":" <TypNoCaret>)*> => {
        let mut m = b;
        for t in ts {
            m = MPat::Typ(Box::new(m), t);
        }
        m
    },
}

AtomicMPatBase: MPat = {
    <l:NegLit> => MPat::Lit(l),
    <i:Ident> => MPat::Id(i),
    <i:Ident> <t:MPatIdTail> => match t {
        MPatIdTail::Call(args) => MPat::App(i, args),
        MPatIdTail::Subrange(lo, hi) => MPat::VectorSubrange(i, lo, hi),
    },
    "(" <m:MPat> ")" => m,
    "(" <m:MPat> "," <ms:MPatList> ")" => {
        let mut v = vec![m];
        v.extend(ms);
        MPat::Tuple(v)
    },
    "(" <m:MPat> "," ")" => MPat::Tuple(vec![m]),
    "[" <ms:MPatList?> "]" => MPat::Vector(ms.unwrap_or_default()),
    "[|" <ms:MPatList?> "|]" => MPat::List(ms.unwrap_or_default()),
    "struct" <i:Ident?> "{" <fs:FMPatList?> "}" => MPat::Struct(i, fs.unwrap_or_default()),
}

MPatIdTail: MPatIdTail = {
    "()" => MPatIdTail::Call(vec![MPat::Lit(Lit::Unit)]),
    "(" <ms:MPatList> ")" => MPatIdTail::Call(ms),
    "[" <lo:RawNum> <hi:(".." <RawNum>)?> "]" => {
        let hi = hi.unwrap_or_else(|| lo.clone());
        MPatIdTail::Subrange(lo, hi)
    },
}

// `fmpat`: the `("=" <MPat>)?` tail is two explicit arms (Lane 99,
// Fix-8 shape) — the old tail left an empty production whose reduce
// competed with the `=` shift (Rig 1136:5-1139:5). Same accepted
// language.
FMPat: (String, MPat) = {
    <i:Ident> => (i.clone(), MPat::Id(i)),
    <i:Ident> "=" <m:MPat> => (i, m),
}

FMPatList: Vec<(String, MPat)> = {
    <f:FMPat> => vec![f],
    <f:FMPat> "," <fs:FMPatList> => {
        let mut v = vec![f];
        v.extend(fs);
        v
    },
    <f:FMPat> "," => vec![f],
}

// `mpexp`.
MPExp: MPExp = {
    <m:MPat> <g:("if" <Exp>)?> => MPExp { pat: m, guard: g },
}

// `mapcl0`.
MapCl0: MapCl = {
    <m:MPExp> "<->" <n:MPExp> => MapCl::Bidir(m, n),
    <m:MPExp> "=>" <e:Exp> => MapCl::ForwardsDeprecated(m, e),
    "forwards" <c:Case> => MapCl::Forwards(c),
    "backwards" <c:Case> => MapCl::Backwards(c),
}

// `mapcl`.
MapCl: MapCl = {
    <a:Attrs> <m:MapCl> => MapCl::Attr(a, Box::new(m)),
    <d:DocComment> <m:MapCl> => MapCl::Doc(d, Box::new(m)),
    <m:MapCl0> <w:("when" <Exp>)?> => match w {
        Some(g) => MapCl::When(Box::new(m), g),
        None => m,
    },
}

// `mapcl_list` (trailing comma allowed).
// E4-strict (Lane 99, same shape as the other comma lists): the old
// nullable list expanded to `(...)+` intermediates. The `mapping` use
// site keeps `?`, so `= {}` still parses (via `None`); accepted language
// unchanged.
MapClList: Vec<MapCl> = {
    <m:MapCl> => vec![m],
    <m:MapCl> "," <ms:MapClList> => {
        let mut v = vec![m];
        v.extend(ms);
        v
    },
    <m:MapCl> "," => vec![m],
}

// `map_def`.
MapDef: MapDef = {
    "mapping" <i:Ident> <t:(":" <TypSchm>)?> "=" "{" <cs:MapClList?> "}" => MapDef {
        name: i,
        typschm: t,
        clauses: cs.unwrap_or_default(),
    },
}

// ---------------------------------------------------------------------------
// type definitions
// ---------------------------------------------------------------------------

// `typaram`.
TyParam: TypQuant = {
    "()" <t:TyParamTail?> => TypQuant { kopts: vec![], constraint: t.map(Box::new) },
    "(" <ks:ParamKOptList?> ")" <t:TyParamTail?> => TypQuant {
        kopts: ks.unwrap_or_default(),
        constraint: t.map(Box::new),
    },
}

TyParamTail: Typ = {
    "," <t:Typ> => t,
    "constraint" <t:Typ> => t,
}

// `param_kopt`.
ParamKOpt: KOpt = {
    <k:Kid> <t:(":" <Kind>)?> => KOpt { constant: false, kids: vec![k], kind: t },
}

ParamKOptList: Vec<KOpt> = {
    <k:ParamKOpt> => vec![k],
    <k:ParamKOpt> "," <ks:ParamKOptList> => {
        let mut v = vec![k];
        v.extend(ks);
        v
    },
    <k:ParamKOpt> "," => vec![k],
}

// `unbracketed_typaram`: the `("constraint" <Typ>)?` tail is two explicit
// arms (Lane 99, Fix-8 shape) — the old tail left an empty production
// whose reduce competed with the `constraint` shift
// (Rig 1220:5-1223:5). Same accepted language.
UnbracketedTyParam: TypQuant = {
    "()" <t:TyParamTail?> => TypQuant { kopts: vec![], constraint: t.map(Box::new) },
    <ks:ParamKOptList> => TypQuant {
        kopts: ks,
        constraint: None,
    },
    <ks:ParamKOptList> "constraint" <t:Typ> => TypQuant {
        kopts: ks,
        constraint: Some(Box::new(t)),
    },
}

// `type_def` (struct/enum/newtype/union/bitfield; `type` handled in DefAux).
TypeDef: TypeDef = {
    "struct" <i:Ident> <p:TyParam?> "=" "{" <fs:StructFields?> "}" => TypeDef::Record(
        i,
        p.unwrap_or(TypQuant { kopts: vec![], constraint: None }),
        fs.unwrap_or_default(),
    ),
    "enum" <i:Ident> <e:EnumBody> => TypeDef::Enum(i, e.0, e.1),
    "newtype" <i:Ident> <p:TyParam?> "=" <u:TypeUnion> => TypeDef::Variant(
        i,
        p.unwrap_or(TypQuant { kopts: vec![], constraint: None }),
        vec![u],
        true,
    ),
    "union" <i:Ident> <p:TyParam?> "=" "{" <us:TypeUnions?> "}" => TypeDef::Variant(
        i,
        p.unwrap_or(TypQuant { kopts: vec![], constraint: None }),
        us.unwrap_or_default(),
        false,
    ),
    "bitfield" <i:Ident> ":" <t:Typ> "=" "{" <rs:RDefBody?> "}" => TypeDef::Bitfield(
        i,
        t,
        rs.unwrap_or_default(),
    ),
}

// `typedef ...` / `type constraint ...` sharing the `type` prefix.
TypedefTail: DefAux = {
    "constraint" <t:Typ> => DefAux::Constraint(t),
    <i:Ident> <p:TyParam?> "=" <t:Typ> => DefAux::Type(TypeDef::Abbrev(
        i,
        p.unwrap_or(TypQuant { kopts: vec![], constraint: None }),
        None,
        t,
    )),
    <i:Ident> <p:TyParam?> "->" <k:Kind> "=" <t:Typ> => DefAux::Type(TypeDef::Abbrev(
        i,
        p.unwrap_or(TypQuant { kopts: vec![], constraint: None }),
        Some(k),
        t,
    )),
    <i:Ident> ":" <k:Kind> "=" <t:Typ> => DefAux::Type(TypeDef::Abbrev(
        i,
        TypQuant { kopts: vec![], constraint: None },
        Some(k),
        t,
    )),
    <i:Ident> ":" <k:Kind> <io:AbstractInst?> => DefAux::Type(TypeDef::Abstract(i, k, io)),
}

AbstractInst: Vec<String> = {
    "=" "config" <k:RawId> => vec![k],
    "=" "config" <k:RawId> "." <ks:ConfigKeyTail> => {
        let mut v = vec![k];
        v.extend(ks);
        v
    },
}

// `config` key tail: use-site-local chain (Lane 103) — Menhir
// (`sail/src/lib/parser.mly:1039-1043`) keeps `abstract_instantiation`
// flat (`Eq; Config; key=separated_nonempty_list(Dot, Id)`) and lets its
// shift-preference decide. Our named `ConfigKey` nonterminal re-created
// the decision state on every encoding: right-recursive merged the outer
// and inner after-`RawId` cores into one state (Rig 1375:5-1375:24), and
// left-recursive (Lane 102) kept a shared `ConfigKey` state whose reduce
// (`AbstractInst`) competes with the `"."` shift (Rig 1385:5-1385:37).
// Peeling the first key into `AbstractInst` gives the outer decision
// state a single-path context and the inner tail its own nonterminal, so
// the `.`-vs-stop decision no longer shares a state across nesting
// levels. Same keys in the same order; accepted language unchanged.
ConfigKeyTail: Vec<String> = {
    <k:RawId> => vec![k],
    <k:RawId> "." <ks:ConfigKeyTail> => {
        let mut v = vec![k];
        v.extend(ks);
        v
    },
}

// `enum` body after the name.
EnumBody: (Vec<(String, Typ)>, Vec<(EnumMember, Option<Exp>)>) = {
    "=" <m:EnumBar> => (
        vec![],
        m.into_iter().map(|i| (EnumMember::Item(i), None)).collect(),
    ),
    "=" "{" <e:Enum?> "}" => (vec![], e.unwrap_or_default()),
    "with" <f:EnumFns?> "=" "{" <e:Enum?> "}" => (f.unwrap_or_default(), e.unwrap_or_default()),
}

// `enum_bar`.
EnumBar: Vec<String> = {
    <i:Ident> <mut is:("|" <Ident>)*> => {
        let mut v = vec![i];
        v.append(&mut is);
        v
    },
}

// `enum_functions` member.
EnumFn: (String, Typ) = {
    <i:Ident> "->" <t:Typ> => (i, t),
}

EnumFns: Vec<(String, Typ)> = {
    <f:EnumFn> => vec![f],
    <f:EnumFn> "," <fs:EnumFns> => {
        let mut v = vec![f];
        v.extend(fs);
        v
    },
    <f:EnumFn> "," => vec![f],
}

// `enum` member list (trailing comma allowed).
// `enum` member list: E4-strict (Lane 98) — non-empty, right-recursive,
// explicit trailing-"," arm (Lane-87 `RDefBody` shape). The old nullable
// list expanded to `(...)+`/`(...)*` intermediates (Rig 1215:5-1218:5).
// Use sites keep `?`, so `= {}` still parses (via `None`); accepted
// language unchanged.
Enum: Vec<(EnumMember, Option<Exp>)> = {
    <m:EnumMember> => vec![m],
    <m:EnumMember> "," <e:Enum> => {
        let mut v = vec![m];
        v.extend(e);
        v
    },
    <m:EnumMember> "," => vec![m],
}

// `enum_member`.
EnumMember: (EnumMember, Option<Exp>) = {
    <a:Attrs> <m:EnumMember> => (EnumMember::Attr(a, Box::new(m.0)), m.1),
    <d:DocComment> <m:EnumMember> => (EnumMember::Doc(d, Box::new(m.0)), m.1),
    <i:Ident> <v:("=>" <Exp>)?> => (EnumMember::Item(i), v),
}

// `struct_field`.
StructField: StructField = {
    <a:Attrs> <f:StructField> => StructField::Attr(a, Box::new(f)),
    <d:DocComment> <f:StructField> => StructField::Doc(d, Box::new(f)),
    <n:Ident> ":" <t:Typ> => StructField::Item(n, t),
}

// `struct` fields: E4-strict (Lane 98) — non-empty, right-recursive,
// explicit trailing-"," arm (Lane-87 `RDefBody` shape). The old nullable
// list expanded to `(...)+`/`(...)*` intermediates (Rig 309:5-312:5 local
// ambiguity via `{}`). Both use sites (`struct` record, `TypeUnion` anon
// record) keep `?`, so `= {}` still parses (via `None`); accepted
// language unchanged.
StructFields: Vec<StructField> = {
    <f:StructField> => vec![f],
    <f:StructField> "," <fs:StructFields> => {
        let mut v = vec![f];
        v.extend(fs);
        v
    },
    <f:StructField> "," => vec![f],
}

// `type_union`.
TypeUnion: TypeUnion = {
    <a:Attrs> <u:TypeUnion> => TypeUnion::Attr(a, Box::new(u)),
    <d:DocComment> <u:TypeUnion> => TypeUnion::Doc(d, Box::new(u)),
    "private" <u:TypeUnion> => TypeUnion::Private(Box::new(u)),
    <i:Ident> ":" <t:Typ> <f:("->" <Typ>)?> => match f {
        Some(ret) => TypeUnion::Id(i, Typ::Fn(Box::new(t), Box::new(ret))),
        None => TypeUnion::Id(i, t),
    },
    // `C : {}` (Lane 104): the old `"{" <StructFields?> "}"` anon arm
    // accepted the empty brace, and so does `AtomicTyp`'s
    // `"{" <NumList?> "}"` (empty `NSet`, pinned by `parse_typ("{}")`),
    // giving two trees (Rig limited-run-20261010-193612,
    // `sail.lalrpop:316:5-316:62`; siblings: `TypeUnions`-tail `,`,
    // `union`/`newtype` use sites — all share this rule). Menhir
    // (`parser.mly:1136`, `id Colon Lcurly struct_fields Rcurly`)
    // requires non-empty `struct_fields` here (`KOpt` starts at `Kid`
    // / `(`, so no other `{...}` shape overlaps), hence the strict
    // list. `C : {}` now parses only as `Id(C, NSet([]))`; the
    // `struct`-record use site keeps `?`. Accepted language unchanged.
    <i:Ident> ":" "{" <fs:StructFields> "}" => TypeUnion::AnonRecord(i, fs),
}

TypeUnions: Vec<TypeUnion> = {
    <u:TypeUnion> => vec![u],
    <u:TypeUnion> "," <us:TypeUnions> => {
        let mut v = vec![u];
        v.extend(us);
        v
    },
    <u:TypeUnion> "," => vec![u],
}

// `index_range`: the parenthesised arm `"(" IndexRange ")"` was removed
// (Lane 76) — it duplicated `AtomicTyp`'s `"(" Typ ")"` for every
// parenthesised type, so `(t)` was ambiguous and `(a, b)` conflicted.
// Bare `..`-ranges and `@`-concats cover the corpus (no bitfields in
// `sail-lib`); `(a..b)` / `(a@b)` are rejected, see GRAMMAR.md.
// The `@` tail is two explicit arms (Lane 98) — the old
// `("@" <IndexRange>)?` tail left an empty production whose reduce
// competed with the `@` shift (Rig 1267:5-1270:5). Accepted language
// unchanged.
IndexRange: IndexRange = {
    <a:AtomicIndexRange> => a,
    <a:AtomicIndexRange> "@" <hi:IndexRange> =>
        IndexRange::Concat(Box::new(a), Box::new(hi)),
}

// The `..` tail is two explicit arms (Lane 98) — the old
// `(".." <Typ>)?` tail left an empty production whose reduce competed
// with the `..` shift (Rig 1274:5-1277:5). Accepted language unchanged.
AtomicIndexRange: IndexRange = {
    <t:Typ> => IndexRange::Single(t),
    <t:Typ> ".." <hi:Typ> => IndexRange::Range(t, hi),
}

// `r_id_def`.
RIdDef: RegField = {
    <d:DocComment> <r:RIdDef> => RegField::Doc(d, Box::new(r)),
    <a:RegAttrs> <r:RIdDef> => RegField::Attr(a, Box::new(r)),
    <n:Ident> ":" <r:IndexRange> => RegField::Item(n, r),
}

// `r_id_def` list: E4-strict (Lane 87, re-applied on this branch) —
// non-empty and right-recursive with an explicit trailing-"," arm
// (exactly the validated `Block` shape), so a trailing `,` parses but
// the empty body does not. The use site keeps `RDefBody?`, hence `{}`
// still parses — via exactly one tree (the old nullable
// `(<RIdDef> ",")* <RIdDef>?` list gave `{}` two trees: Rig local
// ambiguity at 1288:5-1291:5). Accepted language is unchanged.
RDefBody: Vec<RegField> = {
    <i:RIdDef> => vec![i],
    <i:RIdDef> "," <b:RDefBody> => {
        let mut v = vec![i];
        v.extend(b);
        v
    },
    <i:RIdDef> "," => vec![i],
}

// Register-item attributes: per-use-site copy of `Attrs`/`AttrsTail`
// (Lane 103) — same arms, same AST. `Attrs` is shared across the whole
// grammar (`Pat`, `ClosedExp`, `AttrCase`, `FunclAnnot`, `MapCl`,
// `EnumMember`, `StructField`, `TypeUnion`, `Def`, …), so the shift-side
// closure of the `RDefBody`-comma decision state carries the union of
// all their contexts, and the trailing-"," reduce competes with the
// shift on every `RIdDef` starter (Rig 1547:5-1547:29: reduce-`RDefBody`
// vs shift on `RawAttr`/`RawDocBlock`/`RawDocLine`/`"operator"`/`RawId`).
// The dedicated copy confines that state's shift-side context to the
// register path (per-use-site dedup against LALR-merge imprecision).
// Accepted language unchanged.
RegAttrs: Vec<Attr> = {
    <a:RawAttr> <d:AttrData> <t:RegAttrsTail> => {
        let mut v = vec![Attr { name: a, data: Some(d) }];
        v.extend(t);
        v
    },
    <a:RawAttr> <t:RegAttrsTail> => {
        let mut v = vec![Attr { name: a, data: None }];
        v.extend(t);
        v
    },
}

RegAttrsTail: Vec<Attr> = {
    "," <i:RawId> <d:AttrData> <t:RegAttrsTail> => {
        let mut v = vec![Attr { name: i, data: Some(d) }];
        v.extend(t);
        v
    },
    "," <i:RawId> <t:RegAttrsTail> => {
        let mut v = vec![Attr { name: i, data: None }];
        v.extend(t);
        v
    },
    "]" => vec![],
}

// ---------------------------------------------------------------------------
// value / register / outcome / scattered / misc definitions
// ---------------------------------------------------------------------------

// `val_spec_def`.
ValSpec: ValSpec = {
    "val" <s:RawStr> ":" <t:TypSchm> => ValSpec {
        name: s.clone(),
        typschm: t,
        ext: Some(Extern { pure: None, bindings: vec![("_".to_string(), s)] }),
    },
    "val" <f:Ident> ":" <t:TypSchm> <e:("=" <Externs>)?> => ValSpec {
        name: f,
        typschm: t,
        ext: e,
    },
    "val" <f:Ident> "=" <e:Externs> ":" <t:TypSchm> => ValSpec {
        name: f,
        typschm: t,
        ext: Some(e),
    },
    "val" "cast" <f:Ident> ":" <t:TypSchm> => ValSpec {
        name: f,
        typschm: t,
        ext: None,
    },
    "val" "cast" <f:Ident> "=" <e:Externs> ":" <t:TypSchm> => ValSpec {
        name: f,
        typschm: t,
        ext: Some(e),
    },
}

// `externs`.
Externs: Extern = {
    <p:PureOpt?> <b:ExternBody> => Extern { pure: p, bindings: b },
}

PureOpt: bool = {
    "monadic" => false,
    "impure" => false,
    "pure" => true,
}

ExternBody: Vec<(String, String)> = {
    <s:RawStr> => vec![("_".to_string(), s)],
    "{" <bs:ExternBindList?> "}" => bs.unwrap_or_default(),
}

// `extern` bindings: E4-strict (Lane 99, same shape as the other comma
// lists); the `"{" ... "}"` use site keeps `?`, so `{}` still parses
// (via `None`); accepted language unchanged.
ExternBindList: Vec<(String, String)> = {
    <b:ExternBind> => vec![b],
    <b:ExternBind> "," <bs:ExternBindList> => {
        let mut v = vec![b];
        v.extend(bs);
        v
    },
    <b:ExternBind> "," => vec![b],
}

ExternBind: (String, String) = {
    <i:Ident> ":" <s:RawStr> => (i, s),
    "_" ":" <s:RawStr> => ("_".to_string(), s),
}

// `outcome_spec_def`.
OutcomeSpec: OutcomeSpec = {
    "outcome" <i:Ident> ":" <t:TypSchm> <p:("with" <UnbracketedTyParam>)?> => OutcomeSpec {
        name: i,
        typschm: t,
        param: p,
    },
}

OutcomeTail: Vec<Def> = {
    "=" "{" <ds:Defs> "}" => ds,
}

// `register_def`: the `("=" <Exp>)?` tails are explicit arms (Lane 99,
// Fix-8 shape) — the old tails left empty productions whose reduces
// competed with the `=` shift (Rig 1509:5-1513:5). Same combinations as
// before; accepted language unchanged.
RegDef: RegDef = {
    "register" <i:Ident> ":" <t:Typ> => RegDef {
        name: i,
        typ: t,
        init: None,
    },
    "register" <i:Ident> ":" <t:Typ> "=" <e:Exp> => RegDef {
        name: i,
        typ: t,
        init: Some(e),
    },
    "register" EffectSet EffectSet <i:Ident> ":" <t:Typ> => RegDef {
        name: i,
        typ: t,
        init: None,
    },
    "register" EffectSet EffectSet <i:Ident> ":" <t:Typ> "=" <e:Exp> => RegDef {
        name: i,
        typ: t,
        init: Some(e),
    },
    "register" "configuration" <i:Ident> ":" <t:Typ> "=" <e:Exp> => RegDef {
        name: i,
        typ: t,
        init: Some(e),
    },
}

// `default_def`.
DefaultDef: DefaultDef = {
    "default" <k:Kind> <o:DefaultOrd> => DefaultDef { kind: k, order: o },
}

DefaultOrd: Typ = {
    "inc" => Typ::Inc,
    "dec" => Typ::Dec,
}

// `funcl_typ`.
FunclTyp: Typ = {
    ForallPart? <t:Typ> => t,
}

// `scattered_def`.
ScatteredDef: ScatteredDef = {
    "scattered" "enum" <i:Ident> => ScatteredDef::Enum(i),
    "scattered" "union" <i:Ident> <p:TyParam?> => ScatteredDef::Variant(
        i,
        p.unwrap_or(TypQuant { kopts: vec![], constraint: None }),
    ),
    "scattered" "function" <i:Ident> => ScatteredDef::Function(i),
    "scattered" "mapping" <i:Ident> <t:(":" <FunclTyp>)?> =>
        ScatteredDef::Mapping(i, t),
    "enum" "clause" <a:Ident> "=" <b:Ident> => ScatteredDef::EnumClause(a, b),
    "function" "clause" <f:Funcl> => ScatteredDef::FunClause(f),
    "union" "clause" <i:Ident> "=" <u:TypeUnion> => ScatteredDef::UnionClause(i, u),
    "mapping" "clause" <i:Ident> "=" <m:MapCl> => ScatteredDef::MapClause(i, m),
    "end" <i:Ident> => ScatteredDef::End(i),
}

// `subst`.
Subst: Subst = {
    <k:Kid> "=" <t:Typ> => Subst::Typ(k, t),
    <a:Ident> "=" <b:Ident> => Subst::Id(a, b),
}

SubstList: Vec<Subst> = {
    <s:Subst> => vec![s],
    <s:Subst> "," <ss:SubstList> => {
        let mut v = vec![s];
        v.extend(ss);
        v
    },
    <s:Subst> "," => vec![s],
}

// `overload_def` body.
OverloadBody: Vec<String> = {
    "{" <i:Ident> <mut is:("," <Ident>)*> "}" => {
        let mut v = vec![i];
        v.append(&mut is);
        v
    },
    <i:Ident> <mut is:("|" <Ident>)*> => {
        let mut v = vec![i];
        v.append(&mut is);
        v
    },
}

// `loop_measure`.
LoopMeasure: (LoopKind, Exp) = {
    "until" <e:Exp> => (LoopKind::Until, e),
    "repeat" <e:Exp> => (LoopKind::Until, e),
    "while" <e:Exp> => (LoopKind::While, e),
}

// `loop_measures`.
LoopMeasures: Vec<(LoopKind, Exp)> = {
    <m:LoopMeasure> <mut ms:("," <LoopMeasure>)*> => {
        let mut v = vec![m];
        v.append(&mut ms);
        v
    },
}

// ---------------------------------------------------------------------------
// top-level definitions
// ---------------------------------------------------------------------------

// `def_aux`.
DefAux: DefAux = {
    <f:FunDef> => DefAux::Fun(f),
    <m:MapDef> => DefAux::Map(m),
    "impl" <f:Funcl> => DefAux::Impl(f),
    <a:RawFixity> => DefAux::Fixity(a.0, a.1, a.2),
    <v:ValSpec> => DefAux::Val(v),
    <o:OutcomeSpec> <t:OutcomeTail?> => DefAux::Outcome(o, t.unwrap_or_default()),
    "instantiation" <i:Ident> <s:("with" <SubstList>)?> =>
        DefAux::Instantiation(i, s.unwrap_or_default()),
    <t:TypeDef> => DefAux::Type(t),
    "type" <t:TypedefTail> => t,
    "let" <p:Pat> "=" <e:Exp> => DefAux::Let(p, e),
    <r:RegDef> => DefAux::Register(r),
    "overload" <i:Ident> "=" <o:OverloadBody> => DefAux::Overload(i, o),
    <d:DefaultDef> => DefAux::Default(d),
    "mutual" "{" <fs:FunDefList> "}" => DefAux::MutRec(fs),
    <p:RawPragma> => DefAux::Pragma(Pragma::Line(p.0, p.1)),
    <s:RawStructPragma> <kvs:AttrKVList?> "}" =>
        DefAux::Pragma(Pragma::Structured(s, kvs.unwrap_or_default())),
    "termination_measure" <i:Ident> <p:Pat> "=" <e:Exp> =>
        DefAux::Measure(i, p, e),
    "termination_measure" <i:Ident> <ms:LoopMeasures> =>
        DefAux::LoopMeasures(i, ms),
    <s:ScatteredDef> => DefAux::Scattered(s),
}

// `def`.
pub Def: Def = {
    "private" <d:Def> => Def::Private(Box::new(d)),
    <a:Attrs> <d:Def> => Def::Attr(a, Box::new(d)),
    <c:DocComment> <d:Def> => Def::Doc(c, Box::new(d)),
    <d:DefAux> => Def::Aux(d),
}

// `defs_list` (constraint-ordering dropped; see GRAMMAR.md).
Defs: Vec<Def> = {
    <ds:Def*> => ds,
}

// `file`.
pub File: Vec<Def> = {
    <ds:Defs> => ds,
}
